# Example settings. You don't need to copy this by hand:
# ./tixsys setup creates the real .env with fresh passwords.

# The address people type to reach the portal (no https:// in front).
# For a quick test without a domain: http://<server-ip>  (no HTTPS in that mode)
TIXSYS_DOMAIN=help.example.org

# Made by setup. Long random values. Never share or commit them.
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

TIME_ZONE=America/Los_Angeles

# Nightly backup time in UTC, and how many automatic backups to keep.
BACKUP_TIME_UTC=10:00
BACKUP_KEEP=14

# Email (optional). Leave EMAIL_HOST empty to keep email off.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_FROM=

# Optional limits (defaults shown).
# MAX_ATTACHMENT_MB=10
# MAX_ATTACHMENTS_PER_UPLOAD=5
# LOGIN_SLOWDOWN_AFTER=5
# LOGIN_LOCKOUT_AFTER=10
# LOGIN_LOCKOUT_MINUTES=30
# PORTAL_TICKETS_PER_IP_PER_HOUR=40
